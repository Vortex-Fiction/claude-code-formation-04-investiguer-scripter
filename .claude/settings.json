{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test:coverage)",
      "Bash(npm run lint)",
      "Bash(npm run lint:doc)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(node scripts/migrations/* --apply*)",
      "Bash(node ./scripts/migrations/* --apply*)",
      "Bash(npm run migrate:* --apply*)",
      "Bash(sqlite3*)",
      "Read(./backend/data/**)",
      "Edit(./backend/data/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\""
          }
        ]
      }
    ]
  }
}
